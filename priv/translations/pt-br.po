#: zotonic_mod_payment_mollie/priv/templates/_admin_payment_config_psp.tpl:3
msgid "Discovery polls the API key’s profile every four hours when collecting all payments is enabled. The synchronization cursor is managed automatically."
msgstr "Quando a coleta de todos os pagamentos está ativada, o perfil da chave API é consultado a cada quatro horas. O cursor de sincronização é gerenciado automaticamente."

#: zotonic_mod_payment_mollie/priv/templates/_admin_payment_config_psp.tpl:3
msgid "Mollie"
msgstr "Mollie"

#: zotonic_mod_payment_mollie/priv/templates/_admin_payment_config_psp.tpl:3
msgid "Mollie webhooks are omitted for new payments and subscriptions: they are disabled or the webhook host is a local .test or localhost domain. Status updates rely on synchronization. Set a public webhook host to use a tunnel."
msgstr "Os webhooks do Mollie são omitidos para novos pagamentos e assinaturas: estão desativados ou o host do webhook é um domínio local .test ou localhost. As atualizações de status dependem da sincronização. Defina um host de webhook público para usar um túnel."
